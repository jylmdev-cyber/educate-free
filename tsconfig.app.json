{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "allowImportingTsExtensions": true, "noEmit": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "verbatimModuleSyntax": true,
    "types": ["vite/client", "node"], "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "tests"]
}
